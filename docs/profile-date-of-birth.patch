diff --git a/webapp/lib/validation/birth-date.ts b/webapp/lib/validation/birth-date.ts
new file mode 100644
index 0000000..0dd0795
--- /dev/null
+++ b/webapp/lib/validation/birth-date.ts
@@ -0,0 +1,6 @@
+export function isValidBirthDate(value: string, today = new Date()): boolean {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(value) || value.startsWith("0000")) return false;
+  const date = new Date(value + "T00:00:00Z");
+  return Number.isFinite(date.getTime()) && date.toISOString().slice(0, 10) === value
+    && value <= today.toISOString().slice(0, 10);
+}
