  // S-7 (automatic renewal): a renewal invoice names its billing subscription and the
  // period it pays for (partial unique indexes in raw SQL: one per period, one per
  // Paymob renewal transaction).
  billingSubscriptionId String?                 @map("billing_subscription_id") @db.Uuid
