diff --git a/webapp/lib/messaging/openwa-url.ts b/webapp/lib/messaging/openwa-url.ts
new file mode 100644
index 0000000..e718621
--- /dev/null
+++ b/webapp/lib/messaging/openwa-url.ts
@@ -0,0 +1,11 @@
+export function getOpenWaBaseUrl(raw = process.env.OPENWA_URL): string | undefined {
+  const value = raw?.trim();
+  if (!value) return undefined;
+  try {
+    const url = new URL(value.includes("://") ? value : "https://" + value);
+    if (!["http:", "https:"].includes(url.protocol) || url.username || url.password || url.search || url.hash) return undefined;
+    return url.href.replace(/\/+$/, "");
+  } catch {
+    return undefined;
+  }
+}
