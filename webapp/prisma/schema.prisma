model NotificationJob {
  id                String                @id @default(uuid()) @db.Uuid
  academyId         String                @map("academy_id") @db.Uuid
  sessionId         String?               @map("session_id") @db.Uuid
  recipientUserId   String                @map("recipient_user_id") @db.Uuid
  kind              String
  dedupKey          String                @unique @map("dedup_key")
  scheduledFor      DateTime              @map("scheduled_for") @db.Timestamptz(6)
  status            NotificationJobStatus @default(PENDING)
  attempts          Int                   @default(0)
  lastError         String?               @map("last_error")
  sentAt            DateTime?             @map("sent_at") @db.Timestamptz(6)
  // Session 1 (2026-10-18): composition context for message kinds that need more
  // than the session link. REDACTION RULE (CONTEXT §5/§24): only ids/keys/enum
  // values and small counts — NEVER free text, credentials, or links.
  reportId          String?               @map("report_id") @db.Uuid
  payload           Json?
  // Session 3 (owner decision 2026-10-24): per-recipient unread tracking for the
  // notification bell. NULL = not seen. Set by the viewer's own ack action (the
  // bell click), never by the worker. Operator queue badges (applications/reports/
  // requests) are team queues and do not use it.
  readAt            DateTime?             @map("read_at") @db.Timestamptz(6)
  // WhatsApp slice (d) (2026-10-25): delivery tracking from the signed OpenWA
  // status webhook. Ids and statuses only — never message content.
  providerMessageId String?               @map("provider_message_id") @db.VarChar(255)
  deliveryStatus    String?               @map("delivery_status") @db.VarChar(16)
  deliveryUpdatedAt DateTime?             @map("delivery_updated_at") @db.Timestamptz(6)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  academy           Academy               @relation(fields: [academyId], references: [id], onDelete: Restrict)
  session           Session?              @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  recipientUser     User                  @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)
  report            Report?               @relation("NotificationJobReport", fields: [reportId], references: [id], onDelete: Restrict)

  @@index([academyId, status, scheduledFor])
  @@index([reportId])
  @@index([providerMessageId], map: "notification_jobs_provider_message_id_idx")
  @@map("notification_jobs")
}

/// Admin individual WhatsApp message (slice d). The free-text body lives ONLY
/// here so notification_jobs.payload keeps its redaction rule ({adminMessageId}).
/// ADMIN-only read/write; the body is never logged or returned to other roles.
model AdminMessage {
  id              String   @id @default(uuid()) @db.Uuid
