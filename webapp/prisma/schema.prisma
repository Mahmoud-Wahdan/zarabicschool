generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

enum SessionReservationStatus {
  RESERVED
  RELEASED
  CONSUMED
}

model Report {
  id                     String               @id @default(uuid()) @db.Uuid
  academyId              String               @map("academy_id") @db.Uuid
  sessionId              String               @map("session_id") @db.Uuid
  studentId              String               @map("student_id") @db.Uuid
  teacherId              String               @map("teacher_id") @db.Uuid
  reportType             ReportType           @map("report_type")
  status                 ReportStatus         @default(SUBMITTED)
  attendanceOutcome      AttendanceOutcome    @map("attendance_outcome")
  classRemark            String               @map("class_remark")
  summary                String
  homework               String
  notes                  String?
  operationalEvents      Json?                @map("operational_events")
  extraTimeMinutes       Int                  @default(0) @map("extra_time_minutes")
  extraTimeStatus        ExtraTimeStatus      @default(NONE) @map("extra_time_status")
  extraTimeReviewedById  String?              @map("extra_time_reviewed_by") @db.Uuid
  extraTimeReviewedAt    DateTime?            @map("extra_time_reviewed_at") @db.Timestamptz(6)
  submittedAt            DateTime             @default(now()) @map("submitted_at") @db.Timestamptz(6)
  rejectionReason        String?              @map("rejection_reason")
  rejectedById           String?              @map("rejected_by") @db.Uuid
  rejectedAt             DateTime?            @map("rejected_at") @db.Timestamptz(6)
  approvedAt             DateTime?            @map("approved_at") @db.Timestamptz(6)
  approvedById           String?              @map("approved_by") @db.Uuid
  settledAt              DateTime?            @map("settled_at") @db.Timestamptz(6)
  archivedAt             DateTime?            @map("archived_at") @db.Timestamptz(6)
  language               ReportLanguage       @default(ar)
  // PROPOSAL (owner, 2026-10-18): incremented per Admin/Supervisor rejection;
  // informational for Admin/Supervisor only — never an automatic red mark or penalty.
  rejectionCount         Int                  @default(0) @map("rejection_count")
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  academy                Academy              @relation("ReportAcademy", fields: [academyId], references: [id], onDelete: Restrict)
  session                Session              @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  student                Student              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  teacher                Teacher              @relation("ReportTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  approvedBy             User?                @relation("ReportApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  rejectedBy             User?                @relation("ReportRejectedBy", fields: [rejectedById], references: [id], onDelete: Restrict)
  extraTimeReviewedBy    User?                @relation("ReportExtraTimeReviewer", fields: [extraTimeReviewedById], references: [id], onDelete: Restrict)
  attachments            ReportAttachment[]   @relation("ReportAttachment")
  subscriptionDeductions SubscriptionLedger[] @relation("LedgerReport")
  payrollEntries         PayrollLedger[]      @relation("PayrollLedgerReport")
  notificationJobs       NotificationJob[]    @relation("NotificationJobReport")

  @@unique([sessionId, studentId, reportType])
  @@index([academyId, status, submittedAt])
  @@index([teacherId, status])
  @@map("reports")
}

model ReportAttachment {
  id              String   @id @default(uuid()) @db.Uuid
  academyId       String   @map("academy_id") @db.Uuid
  reportId        String   @map("report_id") @db.Uuid
  filePath        String   @map("file_path")
  mimeType        String   @map("mime_type")
  sizeBytes       BigInt   @map("size_bytes")
  originalName    String   @map("original_name")
  // Cloudinary switch (2026-10-25): file_path = provider object key (public_id);
  // the object's identity is stored, never a URL. Legacy rows = 'supabase'.
  storageProvider String   @default("supabase") @map("storage_provider") @db.VarChar(20)
  resourceType    String?  @map("resource_type") @db.VarChar(20)
  format          String?  @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  academy         Academy  @relation("ReportAttachmentAcademy", fields: [academyId], references: [id], onDelete: Restrict)
  report          Report   @relation("ReportAttachment", fields: [reportId], references: [id], onDelete: Restrict)

  @@index([reportId])
  @@index([academyId, createdAt])
  @@map("report_attachments")
}

// Session 1 (owner, 2026-10-18; PROPOSAL until confirmed — CONTEXT §9):
// the teacher's MONTHLY report, a separate stream from Reports. NO money, NO
// attendance, NO ledger, NO approval gate. Unique per (teacher, student, month);
// only months that have started; teacher edit window = 7 days after submission.
model MonthlyReport {
  id                  String                  @id @default(uuid()) @db.Uuid
  academyId           String                  @map("academy_id") @db.Uuid
  teacherId           String                  @map("teacher_id") @db.Uuid
  studentId           String                  @map("student_id") @db.Uuid
  monthKey            String                  @map("month_key") @db.VarChar(7)
  achievement         String
  learningProgress    MonthlyLearningProgress @map("learning_progress")
  classFocus          MonthlyEngagementBand   @map("class_focus")
  homeworkCompletion  MonthlyHomeworkBand     @map("homework_completion")
  punctuality         MonthlyEngagementBand
  // Computed server-side from replacement sessions / approved outage requests
  // in that month; pre-filled, read-only for the teacher.
  rescheduledSessions Int                     @default(0) @map("rescheduled_sessions")
  supportAreas        String?                 @map("support_areas")
  nextMonthObjectives String?                 @map("next_month_objectives")
  language            ReportLanguage          @default(ar)
  submittedAt         DateTime                @default(now()) @map("submitted_at") @db.Timestamptz(6)
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  academy             Academy                 @relation(fields: [academyId], references: [id], onDelete: Restrict)
  teacher             Teacher                 @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  student             Student                 @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([teacherId, studentId, monthKey])
  @@index([academyId, monthKey])
  @@index([teacherId, monthKey])
  @@index([studentId])
  @@map("monthly_reports")
}

model AcademySetting {
  id        String   @id @default(uuid()) @db.Uuid
  academyId String   @map("academy_id") @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  academy   Academy  @relation("AcademySettingAcademy", fields: [academyId], references: [id], onDelete: Restrict)

  @@unique([academyId, key])
  @@map("academy_settings")
}

model SessionReservation {
  id             String                   @id @default(uuid()) @db.Uuid
  academyId      String                   @map("academy_id") @db.Uuid
  sessionId      String                   @map("session_id") @db.Uuid
  studentId      String                   @map("student_id") @db.Uuid
  subscriptionId String                   @map("subscription_id") @db.Uuid
  status         SessionReservationStatus @default(RESERVED)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  releasedAt     DateTime?                @map("released_at") @db.Timestamptz(6)
  academy        Academy                  @relation(fields: [academyId], references: [id], onDelete: Restrict)
  session        Session                  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  student        Student                  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  subscription   Subscription             @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, studentId])
  @@index([subscriptionId, status])
  @@index([academyId, status])
  @@map("session_reservations")
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SUPERVISOR
  TEACHER
  STUDENT
  GUARDIAN
}

enum ApplicationType {
  GUARDIAN
  STUDENT
  TEACHER
}

enum ApplicationStatus {
  NEW
  REVIEWED
  APPROVED
  REJECTED
}

enum GuardianRelationship {
  FATHER
  MOTHER
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum PaymentProvider {
  PAYMOB
  USD_GATEWAY
}

enum PaymentAttemptStatus {
  CREATED
  REDIRECTED
  SUCCEEDED
  FAILED
}

enum SubscriptionPackageType {
  MONTHLY_PLAN
  ANNUAL_PLAN
  PAY_PER_SESSION
}

enum SubscriptionStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  CANCELLED
}

enum SubscriptionLedgerEntryType {
  INITIAL_PURCHASE
  SESSION_DEDUCTION
  EXPIRY
  ADMIN_ADJUSTMENT
  REFUND
}

enum RecurrenceSeriesStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum NotificationJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum SessionChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SessionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  MISSED
  CANCELLED
}

enum SessionType {
  PRIVATE
  GROUP
}

enum AssignmentStatus {
  ACTIVE
  ENDED
}

enum AttendanceStatus {
  PENDING
  ATTENDED
  STUDENT_ABSENT
}

enum ReportType {
  SESSION_COMPLETION_REPORT
}

enum ReportStatus {
  SUBMITTED
  REJECTED
  APPROVED
  ARCHIVED
}

enum AttendanceOutcome {
  ATTENDED
  STUDENT_ABSENT
}

enum ExtraTimeStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

// Session 1 (owner, 2026-10-18): teachers write reports in the student's
// language. Site UI stays ar/en; this enum is about report CONTENT language.
enum ReportLanguage {
  ar
  en
  fr
  de
  tr
}

// Monthly report (NEW stream, CONTEXT §9): progress bands.
enum MonthlyLearningProgress {
  EXCELLENT
  VERY_GOOD
  GOOD
  VERY_SLOW_PROGRESS
}

enum MonthlyEngagementBand {
  ALWAYS
  OFTEN
  SOMETIMES
  RARELY
}

enum MonthlyHomeworkBand {
  ALWAYS
  MOST_OF_THE_TIME
  SOMETIMES
  RARELY
}

enum PayrollLedgerEntryType {
  SESSION_CREDIT
  ADMIN_ADJUSTMENT
  DISBURSEMENT
}

enum PaymentProofStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model Academy {
  id                        String                     @id @default(uuid()) @db.Uuid
  name                      String                     @unique
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  users                     User[]
  applications              Application[]
  subjects                  Subject[]
  guardians                 Guardian[]
  students                  Student[]
  teachers                  Teacher[]
  teacherSubjects           TeacherSubject[]
  subscriptions             Subscription[]
  invoices                  Invoice[]
  subscriptionLedger        SubscriptionLedger[]
  sessions                  Session[]
  reservations              SessionReservation[]
  reports                   Report[]                   @relation("ReportAcademy")
  recurrenceSeries          RecurrenceSeries[]
  notificationJobs          NotificationJob[]
  sessionChangeRequests     SessionChangeRequest[]
  teacherFlags              TeacherFlag[]
  studentSubjects           StudentSubject[]           @relation("StudentSubjectAcademy")
  studentTeacherAssignments StudentTeacherAssignment[] @relation("StudentTeacherAssignmentAcademy")
  sessionLinkAudits         SessionLinkAudit[]
  reportAttachments         ReportAttachment[]         @relation("ReportAttachmentAcademy")
  academySettings           AcademySetting[]           @relation("AcademySettingAcademy")
  sessionRequests           SessionRequest[]           @relation("SessionRequestAcademy")
  teacherRates              TeacherRate[]              @relation("TeacherRateAcademy")
  payrollLedger             PayrollLedger[]            @relation("PayrollLedgerAcademy")
  paymentProofs             PaymentProof[]             @relation("PaymentProofAcademy")
  monthlyReports            MonthlyReport[]
  billingPlans              BillingPlan[]              @relation("BillingPlanAcademy")
  billingSubscriptions      BillingSubscription[]      @relation("BillingSubscriptionAcademy")
  exchangeRates             ExchangeRate[]             @relation("ExchangeRateAcademy")
  paymentAuditRows          PaymentAudit[]             @relation("PaymentAuditAcademy")
  sessionEvaluations        SessionEvaluation[]        @relation("SessionEvaluationAcademy")
  adminMessages             AdminMessage[]             @relation("AdminMessageAcademy")
  sessionJoinClicks         SessionJoinClick[]         @relation("SessionJoinClickAcademy")
  applicationRecords        ApplicationRecord[]        @relation("ApplicationRecordAcademy")
  announcements             Announcement[]             @relation("AnnouncementAcademy")
  complaints                Complaint[]                @relation("ComplaintAcademy")
  attendanceResolutions     AttendanceResolution[]     @relation("AttendanceResolutionAcademy")

  @@map("academies")
}

model User {
  id                            String                     @id @default(uuid()) @db.Uuid
  academyId                     String                     @map("academy_id") @db.Uuid
  username                      String
  email                         String?
  passwordHash                  String                     @map("password_hash")
  displayName                   String                     @map("display_name")
  phone                         String?
  role                          UserRole
  timezone                      String                     @default("Africa/Cairo")
  /// S-3 (D39): DEFAULT | DEVICE | USER | ADMIN; the device updates the zone only while DEFAULT/DEVICE. CHECK in raw SQL.
  timezoneSource                String                     @default("DEFAULT") @map("timezone_source") @db.VarChar(8)
  preferredLanguage             String                     @default("ar") @map("preferred_language")
  isActive                      Boolean                    @default(true) @map("is_active")
  // Phase 7 follow-up (owner, 2026-10-26): Admin-only "no announcements" flag —
  // excluded from announcement WhatsApp; the in-app copy stays. Self opt-out is OPEN.
  announcementsOptOut           Boolean                    @default(false) @map("announcements_opt_out")
  mustChangePassword            Boolean                    @default(true) @map("must_change_password")
  passwordChangedAt             DateTime?                  @map("password_changed_at") @db.Timestamptz(6)
  // B4 (2026-10-26): who/when last set this password administratively (audit only).
  passwordSetById               String?                    @map("password_set_by_id") @db.Uuid
  passwordSetAt                 DateTime?                  @map("password_set_at") @db.Timestamptz(6)
  passwordSetBy                 User?                      @relation("UserPasswordSetBy", fields: [passwordSetById], references: [id], onDelete: Restrict, map: "users_password_set_by_id_fkey")
  passwordsSetForUsers          User[]                     @relation("UserPasswordSetBy")
  createdAt                     DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  academy                       Academy                    @relation(fields: [academyId], references: [id], onDelete: Restrict)
  reviewedApplications          Application[]              @relation("ApplicationReviewer")
  approvedApplications          Application[]              @relation("ApplicationApprover")
  approvedByApplications        Application[]              @relation("ApplicationApprovedBy")
  guardianProfile               Guardian?                  @relation("GuardianUser")
  studentProfile                Student?                   @relation("StudentUser")
  teacherProfile                Teacher?                   @relation("TeacherUser")
  approvedTeachers              Teacher[]                  @relation("TeacherApprovedBy")
  notificationReads             NotificationRead[]         @relation("NotificationReadUser")
  createdApplicationRecords     ApplicationRecord[]        @relation("ApplicationCreatedUser")
  overriddenSessionStudents     SessionStudent[]           @relation("SessionStudentOverride")
  sessionJoinClicks             SessionJoinClick[]
  approvedReports               Report[]                   @relation("ReportApprovedBy")
  rejectedReports               Report[]                   @relation("ReportRejectedBy")
  extraTimeReports              Report[]                   @relation("ReportExtraTimeReviewer")
  recurrenceSeries              RecurrenceSeries[]
  notificationJobs              NotificationJob[]
  reviewedSessionChangeRequests SessionChangeRequest[]     @relation("SessionChangeRequestReviewer")
  createdSessions               Session[]                  @relation("SessionCreatedBy")
  cancelledSessions             Session[]                  @relation("SessionCancelledBy")
  createdAssignments            StudentTeacherAssignment[] @relation("AssignmentCreatedBy")
  assignmentOverriddenSessions  Session[]                  @relation("SessionAssignmentOverriddenBy")
  sessionLinkAudits             SessionLinkAudit[]         @relation("SessionLinkAuditChangedBy")
  sessionRequests               SessionRequest[]           @relation("SessionRequestRequestedBy")
  reviewedSessionRequests       SessionRequest[]           @relation("SessionRequestReviewedBy")
  createdTeacherRates           TeacherRate[]              @relation("TeacherRateCreatedBy")
  createdPayrollEntries         PayrollLedger[]            @relation("PayrollLedgerCreatedBy")
  uploadedPaymentProofs         PaymentProof[]             @relation("PaymentProofUploadedBy")
  reviewedPaymentProofs         PaymentProof[]             @relation("PaymentProofReviewedBy")
  createdExchangeRates          ExchangeRate[]             @relation("ExchangeRateCreatedBy")
  payerBillingSubscriptions     BillingSubscription[]      @relation("BillingSubscriptionPayer")
  paymentAuditEvents            PaymentAudit[]             @relation("PaymentAuditActor")
  receivedAdminMessages         AdminMessage[]             @relation("AdminMessageRecipient")
  sentAdminMessages             AdminMessage[]             @relation("AdminMessageCreatedBy")
  sessionEvaluationsAuthored    SessionEvaluation[]        @relation("SessionEvaluationAuthor")

  announcementsCreated  Announcement[]         @relation("AnnouncementCreatedBy")
  complaintsFiled       Complaint[]            @relation("ComplaintFiledBy")
  complaintsConcerning  Complaint[]            @relation("ComplaintConcerned")
  complaintsHandled     Complaint[]            @relation("ComplaintHandledBy")
  attendanceResolutions AttendanceResolution[] @relation("AttendanceResolutionResolvedBy")

  @@unique([academyId, username])
  @@index([academyId])
  @@map("users")
}

model Subject {
  id                        String                     @id @default(uuid()) @db.Uuid
  academyId                 String                     @map("academy_id") @db.Uuid
  slug                      String
  nameAr                    String                     @map("name_ar")
  nameEn                    String                     @map("name_en")
  descriptionAr             String?                    @map("description_ar")
  descriptionEn             String?                    @map("description_en")
  icon                      String?
  sortOrder                 Int                        @default(0) @map("sort_order")
  isActive                  Boolean                    @default(true) @map("is_active")
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  academy                   Academy                    @relation(fields: [academyId], references: [id], onDelete: Restrict)
  teacherSubjects           TeacherSubject[]
  sessions                  Session[]
  recurrenceSeries          RecurrenceSeries[]
  studentSubjects           StudentSubject[]
  studentTeacherAssignments StudentTeacherAssignment[]

  @@unique([academyId, slug])
  @@index([academyId, isActive, sortOrder])
  @@map("subjects")
}

model Application {
  id              String              @id @default(uuid()) @db.Uuid
  academyId       String              @map("academy_id") @db.Uuid
  applicationType ApplicationType     @map("application_type")
  details         Json
  contactPhone    String              @map("contact_phone")
  contactEmail    String?             @map("contact_email")
  status          ApplicationStatus   @default(NEW)
  reviewedById    String?             @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?           @map("reviewed_at") @db.Timestamptz(6)
  approvedById    String?             @map("approved_by") @db.Uuid
  approvedAt      DateTime?           @map("approved_at") @db.Timestamptz(6)
  approvedUserId  String?             @map("approved_user_id") @db.Uuid
  rejectionReason String?             @map("rejection_reason")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  academy         Academy             @relation(fields: [academyId], references: [id], onDelete: Restrict)
  reviewedBy      User?               @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  approvedBy      User?               @relation("ApplicationApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedUser    User?               @relation("ApplicationApprover", fields: [approvedUserId], references: [id], onDelete: Restrict)
  createdRecords  ApplicationRecord[]

  @@index([academyId, status, createdAt])
  @@index([contactPhone, applicationType, createdAt])
  @@map("applications")
}

model Guardian {
  id           String               @id @default(uuid()) @db.Uuid
  userId       String               @unique @map("user_id") @db.Uuid
  academyId    String               @map("academy_id") @db.Uuid
  relationship GuardianRelationship
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         User                 @relation("GuardianUser", fields: [userId], references: [id], onDelete: Restrict)
  academy      Academy              @relation(fields: [academyId], references: [id], onDelete: Restrict)
  students     Student[]

  @@index([academyId])
  @@map("guardians")
}

model Student {
  id                    String                     @id @default(uuid()) @db.Uuid
  userId                String                     @unique @map("user_id") @db.Uuid
  guardianId            String?                    @map("guardian_id") @db.Uuid
  isAdult               Boolean                    @default(false) @map("is_adult")
  academyId             String                     @map("academy_id") @db.Uuid
  // Session 1 (owner, 2026-10-18): the language the teacher writes this
  // student's reports in (default ar; Admin/Supervisor edit; CONTEXT §9).
  reportLanguage        ReportLanguage             @default(ar) @map("report_language")
  enrollmentDate        DateTime?                  @map("enrollment_date") @db.Date
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                  User                       @relation("StudentUser", fields: [userId], references: [id], onDelete: Restrict)
  guardian              Guardian?                  @relation(fields: [guardianId], references: [id], onDelete: Restrict)
  academy               Academy                    @relation(fields: [academyId], references: [id], onDelete: Restrict)
  subscriptions         Subscription[]
  invoices              Invoice[]
  sessionStudents       SessionStudent[]           @relation("SessionStudentStudent")
  reports               Report[]
  monthlyReports        MonthlyReport[]
  reservations          SessionReservation[]
  studentSubjects       StudentSubject[]
  assignments           StudentTeacherAssignment[]
  billingSubscriptions  BillingSubscription[]      @relation("BillingSubscriptionStudent")
  evaluations           SessionEvaluation[]
  attendanceResolutions AttendanceResolution[]     @relation("AttendanceResolutionStudent")

  @@index([academyId])
  @@index([guardianId])
  @@map("students")
}

model Subscription {
  id                String                  @id @default(uuid()) @db.Uuid
  academyId         String                  @map("academy_id") @db.Uuid
  studentId         String                  @map("student_id") @db.Uuid
  packageType       SubscriptionPackageType @map("package_type")
  sessionsPurchased Int                     @map("sessions_purchased")
  totalAmountMinor  BigInt                  @map("total_amount_minor")
  currency          String                  @db.VarChar(3)
  periodStartsAt    DateTime?               @map("period_starts_at") @db.Timestamptz(6)
  periodEndsAt      DateTime?               @map("period_ends_at") @db.Timestamptz(6)
  status            SubscriptionStatus      @default(ACTIVE)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  academy           Academy                 @relation(fields: [academyId], references: [id], onDelete: Restrict)
  student           Student                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  invoices          Invoice[]
  ledgerEntries     SubscriptionLedger[]
  reservations      SessionReservation[]

  @@index([academyId, studentId, status])
  @@map("subscriptions")
}

model Session {
  id                         String                 @id @default(uuid()) @db.Uuid
  academyId                  String                 @map("academy_id") @db.Uuid
  teacherId                  String                 @map("teacher_id") @db.Uuid
  subjectId                  String                 @map("subject_id") @db.Uuid
  sessionType                SessionType            @map("session_type")
  scheduledStart             DateTime               @map("scheduled_start") @db.Timestamptz(6)
  scheduledEnd               DateTime               @map("scheduled_end") @db.Timestamptz(6)
  durationMinutes            Int                    @map("duration_minutes")
  timezone                   String                 @default("UTC")
  zoomJoinUrl                String                 @map("zoom_join_url")
  zoomHostUrl                String?                @map("zoom_host_url")
  recurrenceGroupId          String?                @map("recurrence_group_id") @db.Uuid
  recurrenceWeekIndex        Int?                   @map("recurrence_week_index")
  replacementForSessionId    String?                @map("replacement_for_session_id") @db.Uuid
  cancellationReason         String?                @map("cancellation_reason")
  assignmentOverriddenById   String?                @map("assignment_overridden_by_id") @db.Uuid
  assignmentOverrideReason   String?                @map("assignment_override_reason")
  createdById                String                 @map("created_by") @db.Uuid
  cancelledById              String?                @map("cancelled_by") @db.Uuid
  status                     SessionStatus          @default(SCHEDULED)
