diff --git a/webapp/app/[locale]/account/profile-form.tsx b/webapp/app/[locale]/account/profile-form.tsx
new file mode 100644
index 0000000..254ce50
--- /dev/null
+++ b/webapp/app/[locale]/account/profile-form.tsx
@@ -0,0 +1,58 @@
+"use client";
+
+import { useState, type FormEvent } from "react";
+import { useTranslations } from "next-intl";
+import { useRouter } from "next/navigation";
+
+type Profile = { displayName: string; username: string; email: string; phone: string; preferredLanguage: string };
+const inputs = [
+  { key: "displayName", type: "text", complete: "name", max: 120 },
+  { key: "username", type: "text", complete: "username", max: 30 },
+  { key: "email", type: "email", complete: "email", max: 254 },
+  { key: "phone", type: "tel", complete: "tel", max: 40 },
+] as const;
+
+export default function ProfileForm({ initial }: { initial: Profile }) {
+  const t = useTranslations("account.profile");
+  const router = useRouter();
+  const [busy, setBusy] = useState(false);
+  const [message, setMessage] = useState("");
+  async function save(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    const values = new FormData(event.currentTarget);
+    const changes = Object.fromEntries(Object.entries(initial)
+      .map(([key, original]) => [key, String(values.get(key) ?? "").trim(), original])
+      .filter(([, value, original]) => value !== original)
+      .map(([key, value]) => [key, value]));
+    if (!Object.keys(changes).length) { setMessage(t("unchanged")); return; }
+    setBusy(true);
+    setMessage("");
+    try {
+      const res = await fetch("/api/me/profile", { method: "PATCH", headers: { "Content-Type": "application/json" }, body: JSON.stringify(changes) });
+      if (res.ok) {
+        setMessage(t("saved"));
+        router.refresh();
+      } else {
+        const body = await res.json().catch(() => null);
+        const field = inputs.find(input => body?.error?.fields?.includes(input.key));
+        setMessage(res.status === 409 ? t("taken") : field ? t("invalid", { field: t(field.key) }) : t("failed"));
+      }
+    } catch { setMessage(t("failed")); }
+    finally { setBusy(false); }
+  }
+  return <form onSubmit={save} className="grid max-w-xl gap-4">
+    <h2 className="text-lg font-semibold">{t("title")}</h2>
+    {inputs.map(({ key, type, complete, max }) => <label key={key} className="grid gap-1 text-sm">
+      {t(key)}
+      <input className="z-input" type={type} dir={key === "displayName" ? "auto" : "ltr"} name={key} defaultValue={initial[key]}
+        autoComplete={complete} maxLength={max} required={key === "displayName" || key === "username"} />
+    </label>)}
+    <label className="grid gap-1 text-sm">{t("language")}
+      <select className="z-input" name="preferredLanguage" defaultValue={initial.preferredLanguage}>
+        <option value="ar">العربية</option><option value="en">English</option>
+      </select>
+    </label>
+    <button className="cta-primary justify-self-start rounded-xl px-4 py-2" disabled={busy}>{t("save")}</button>
+    <p role="status">{message}</p>
+  </form>;
+}
diff --git a/webapp/app/api/me/profile/route.ts b/webapp/app/api/me/profile/route.ts
new file mode 100644
index 0000000..9ca7304
--- /dev/null
+++ b/webapp/app/api/me/profile/route.ts
@@ -0,0 +1,44 @@
+import { NextResponse } from "next/server";
+import { z } from "zod";
+import { requireApiRoles } from "../../../../lib/dal";
+import { toInternationalDigits } from "../../../../lib/messaging/phone";
+import { prisma } from "../../../../lib/prisma";
+import { errorResponse, requireSameOrigin } from "../../../../lib/request";
+import { normalizeUsername, usernameSchema } from "../../../../lib/validation/auth";
+
+const phone = z.string().trim().max(40).transform((value, ctx) => {
+  if (!value) return null;
+  const digits = toInternationalDigits(value);
+  if (digits) return `+${digits}`;
+  ctx.addIssue({ code: "custom", message: "Invalid WhatsApp number" });
+  return z.NEVER;
+});
+
+const profile = z.object({
+  displayName: z.string().trim().min(1).max(120),
+  username: usernameSchema.transform(normalizeUsername),
+  email: z.union([z.literal(""), z.string().trim().email().max(254)]).transform(value => value || null),
+  phone,
+  preferredLanguage: z.enum(["ar", "en"]),
+}).partial().strict();
+
+export async function PATCH(request: Request) {
+  const denied = requireSameOrigin(request);
+  if (denied) return denied;
+  const { user, error } = await requireApiRoles(["ADMIN", "SUPERVISOR", "TEACHER", "STUDENT", "GUARDIAN"]);
+  if (error) return error;
+  const parsed = profile.safeParse(await request.json().catch(() => null));
+  if (!parsed.success) {
+    return NextResponse.json({ error: { fields: parsed.error.issues.map(issue => issue.path[0]) } }, { status: 400 });
+  }
+  if (!Object.keys(parsed.data).length) return errorResponse(400, "EMPTY", "No profile changes.");
+  try {
+    await prisma.user.update({ where: { id: user.id, academyId: user.academyId }, data: parsed.data, select: { id: true } });
+  } catch (cause) {
+    if (cause && typeof cause === "object" && "code" in cause && cause.code === "P2002") {
+      return errorResponse(409, "USERNAME_TAKEN", "Username is already in use.");
+    }
+    throw cause;
+  }
+  return NextResponse.json({ ok: true });
+}
