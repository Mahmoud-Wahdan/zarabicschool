}

model PayrollLedger {
  id                      String                 @id @default(uuid()) @db.Uuid
  academyId               String                 @map("academy_id") @db.Uuid
  teacherId               String                 @map("teacher_id") @db.Uuid
  sessionId               String?                @map("session_id") @db.Uuid
  reportId                String?                @map("report_id") @db.Uuid
  teacherRateId           String?                @map("teacher_rate_id") @db.Uuid
  entryType               PayrollLedgerEntryType @map("entry_type")
  // SESSION_CREDIT > 0; ADMIN_ADJUSTMENT may be signed (bonus/fine); DISBURSEMENT < 0
  // (money leaving the balance). CHECK constraints in the migration enforce this.
  amountMinor             Int                    @map("amount_minor")
  currency                String                 @db.VarChar(3)
  minutesCredited         Int?                   @map("minutes_credited")
  hourlyRateSnapshotMinor Int?                   @map("hourly_rate_snapshot_minor")
  reason                  String?
  /// S-5 (D14): BONUS | FINE | OVERTIME | OTHER on new Admin adjustments; NULL on older rows (CHECK in raw SQL).
  adjustmentCategory      String?                @map("adjustment_category") @db.VarChar(20)
  // NULL = system-generated (settlement); NOT NULL = Admin-created (audit).
  createdById             String?                @map("created_by") @db.Uuid
  // A5 (2026-10-26): client Idempotency-Key of an Admin adjustment/disbursement
  // (partial unique payroll_ledger_idempotency_key_key, raw SQL). A3: one overtime
  // entry per report (payroll_ledger_one_overtime_per_report_key, raw SQL).
  idempotencyKey          String?                @map("idempotency_key") @db.Uuid
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  academy                 Academy                @relation("PayrollLedgerAcademy", fields: [academyId], references: [id], onDelete: Restrict, map: "payroll_ledger_academy_fkey")
  teacher                 Teacher                @relation("PayrollLedgerTeacher", fields: [teacherId], references: [id], onDelete: Restrict, map: "payroll_ledger_teacher_fkey")
  session                 Session?               @relation("PayrollLedgerSession", fields: [sessionId], references: [id], onDelete: Restrict, map: "payroll_ledger_session_fkey")
  report                  Report?                @relation("PayrollLedgerReport", fields: [reportId], references: [id], onDelete: Restrict, map: "payroll_ledger_report_fkey")
  teacherRate             TeacherRate?           @relation(fields: [teacherRateId], references: [id], onDelete: Restrict, map: "payroll_ledger_teacher_rate_fkey")
  createdBy               User?                  @relation("PayrollLedgerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([teacherId, currency, createdAt], map: "payroll_ledger_teacher_currency_idx")
  @@index([sessionId], map: "payroll_ledger_session_idx")
  @@index([academyId, createdAt], map: "payroll_ledger_academy_created_idx")
  @@map("payroll_ledger")
}

model PaymentProof {
  id              String             @id @default(uuid()) @db.Uuid
  academyId       String             @map("academy_id") @db.Uuid
  invoiceId       String             @map("invoice_id") @db.Uuid
  uploadedById    String             @map("uploaded_by") @db.Uuid
  filePath        String             @map("file_path")
  mimeType        String             @map("mime_type")
  sizeBytes       BigInt             @map("size_bytes")
  originalName    String             @map("original_name")
  // Cloudinary switch (2026-10-25) — same identity columns as report_attachments.
  storageProvider String             @default("supabase") @map("storage_provider") @db.VarChar(20)
  resourceType    String?            @map("resource_type") @db.VarChar(20)
  format          String?            @db.VarChar(20)
  status          PaymentProofStatus @default(PENDING)
  reference       String?
  reviewedById    String?            @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  reviewNote      String?            @map("review_note")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  academy         Academy            @relation("PaymentProofAcademy", fields: [academyId], references: [id], onDelete: Restrict, map: "payment_proofs_academy_fkey")
  invoice         Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Restrict, map: "payment_proofs_invoice_fkey")
  uploadedBy      User               @relation("PaymentProofUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  reviewedBy      User?              @relation("PaymentProofReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([invoiceId, createdAt], map: "payment_proofs_invoice_created_idx")
  @@index([academyId, status], map: "payment_proofs_academy_status_idx")
  @@map("payment_proofs")
}

enum BillingSubscriptionStatus {
  /// S-7b: consent given, first payment not yet verified (never renews).
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
}

model BillingPlan {
  id               String                  @id @default(uuid()) @db.Uuid
  academyId        String                  @map("academy_id") @db.Uuid
  nameAr           String                  @map("name_ar")
  nameEn           String                  @map("name_en")
  packageType      SubscriptionPackageType @map("package_type")
  sessionsPerMonth Int                     @map("sessions_per_month")
  basePriceMinor   BigInt                  @map("base_price_minor")
  currency         String                  @default("EGP") @db.VarChar(3)
  tier             String?
  isActive         Boolean                 @default(true) @map("is_active")
  /// The Paymob subscription plan id (S-7); unique when set (partial index in raw SQL).
  providerPlanId   String?                 @map("provider_plan_id") @db.VarChar(64)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  academy          Academy                 @relation("BillingPlanAcademy", fields: [academyId], references: [id], onDelete: Restrict)
  subscriptions    BillingSubscription[]   @relation("BillingPlanSubscriptions")

  @@index([academyId, isActive])
  @@map("billing_plans")
}

model ExchangeRate {
  id            String   @id @default(uuid()) @db.Uuid
  academyId     String   @map("academy_id") @db.Uuid
  fromCurrency  String   @map("from_currency") @db.VarChar(3)
  toCurrency    String   @map("to_currency") @db.VarChar(3)
  rate          Decimal  @db.Decimal(20, 8)
  effectiveFrom DateTime @default(now()) @map("effective_from") @db.Timestamptz(6)
  createdById   String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  academy       Academy  @relation("ExchangeRateAcademy", fields: [academyId], references: [id], onDelete: Restrict)
  createdBy     User     @relation("ExchangeRateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([academyId, fromCurrency, toCurrency, effectiveFrom], map: "exchange_rates_academy_id_from_currency_to_currency_effect_idx")
  @@map("exchange_rates")
}

model BillingSubscription {
  id                     String                    @id @default(uuid()) @db.Uuid
  academyId              String                    @map("academy_id") @db.Uuid
  studentId              String                    @map("student_id") @db.Uuid
  payerUserId            String                    @map("payer_user_id") @db.Uuid
  planId                 String                    @map("plan_id") @db.Uuid
  currency               String                    @db.VarChar(3)
  status                 BillingSubscriptionStatus @default(ACTIVE)
  provider               PaymentProvider           @default(PAYMOB)
  providerSubscriptionId String?                   @unique @map("provider_subscription_id")
  lockedPriceMinor       BigInt                    @map("locked_price_minor")
  currentPeriodStart     DateTime                  @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd       DateTime                  @map("current_period_end") @db.Timestamptz(6)
  consentTimestamp       DateTime                  @default(now()) @map("consent_timestamp") @db.Timestamptz(6)
  autoRenew              Boolean                   @default(true) @map("auto_renew")
  canceledAt             DateTime?                 @map("canceled_at") @db.Timestamptz(6)
  graceEndsAt            DateTime?                 @map("grace_ends_at") @db.Timestamptz(6)
  /// D56: day of the month the renewal falls on (1-31; a missing day moves to the month's last day).
  billingAnchorDay       Int?                      @map("billing_anchor_day") @db.SmallInt
  createdAt              DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  academy                Academy                   @relation("BillingSubscriptionAcademy", fields: [academyId], references: [id], onDelete: Restrict)
  student                Student                   @relation("BillingSubscriptionStudent", fields: [studentId], references: [id], onDelete: Restrict)
  payerUser              User                      @relation("BillingSubscriptionPayer", fields: [payerUserId], references: [id], onDelete: Restrict)
  plan                   BillingPlan               @relation("BillingPlanSubscriptions", fields: [planId], references: [id], onDelete: Restrict)
  invoices               Invoice[]                 @relation("BillingSubscriptionInvoices")

  @@index([academyId, status])
  @@index([studentId, status])
  @@index([payerUserId, status])
  @@map("billing_subscriptions")
}

model WebhookEvent {
  id              String          @id @default(uuid()) @db.Uuid
  provider        PaymentProvider
  providerEventId String          @map("provider_event_id")
  eventType       String          @map("event_type")
  payload         Json
  status          String          @default("PROCESSED")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([provider, providerEventId])
  @@index([provider, createdAt])
  @@map("webhook_events")
}

// Session 3 (owner decision 2026-10-24): append-only payment audit trail — one row
// per payment lifecycle event (CREATED / PAID / FAILED / CANCELLED / REJECTED /
// REFUNDED). Minimal SAFE metadata only: never card data, never a gateway payload.
// actor_id is NULL for webhook/system events. The UPDATE/DELETE trigger lives in the
// migration (the ledgers' prevent_ledger_mutation pattern); CANCELLED/REFUNDED have
// no producer until Phase 6b (documented in the phase-06 spec).
model PaymentAudit {
  id        String   @id @default(uuid()) @db.Uuid
  academyId String   @map("academy_id") @db.Uuid
  invoiceId String?  @map("invoice_id") @db.Uuid
  eventType String   @map("event_type") @db.VarChar
  actorId   String?  @map("actor_id") @db.Uuid
  actorRole String?  @map("actor_role") @db.VarChar
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  academy   Academy  @relation("PaymentAuditAcademy", fields: [academyId], references: [id], onDelete: Restrict)
  invoice   Invoice? @relation("PaymentAuditInvoice", fields: [invoiceId], references: [id], onDelete: Restrict)
  actor     User?    @relation("PaymentAuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([academyId, createdAt(sort: Desc)])
  @@index([invoiceId])
  @@map("payment_audit")
}

enum EvaluationAuthorType {
  STUDENT
  GUARDIAN
}

// Session 3 (owner decision 2026-10-24): per-session evaluation of the session/teacher
// by the STUDENT and the GUARDIAN — rating 1..5 + optional comment, ONE per
// (session, author) (owner-confirmed, incl. group sessions and multi-child guardians),
// editable for 24h then locked (server-enforced, no DB trigger). THE TEACHER NEVER
// SEES IT: no teacher route, payload, page or notification may select this table —
// Admin AND Supervisor read it (owner's newest decision, superseding the older
// CONTEXT §9 "Admin-only" line) and relay to the teacher manually with their own text.
// No notifications are enqueued on create/edit.
model SessionEvaluation {
  id           String               @id @default(uuid()) @db.Uuid
  academyId    String               @map("academy_id") @db.Uuid
  sessionId    String               @map("session_id") @db.Uuid
  authorUserId String               @map("author_user_id") @db.Uuid
  studentId    String               @map("student_id") @db.Uuid
  authorType   EvaluationAuthorType @map("author_type")
  rating       Int
  comment      String?              @db.VarChar(2000)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  academy      Academy              @relation("SessionEvaluationAcademy", fields: [academyId], references: [id], onDelete: Restrict)
  session      Session              @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  authorUser   User                 @relation("SessionEvaluationAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  student      Student              @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([sessionId, authorUserId], map: "session_evaluations_session_author_unique")
  @@index([academyId, createdAt(sort: Desc)])
  @@index([sessionId])
  @@map("session_evaluations")
}

// Phase 7 (owner, 2026-10-26): Admin/Supervisor announcement to EVERYONE. The row is
// the in-app copy (widget until expiresAt, history forever); WhatsApp delivery = one
// notification_jobs row per deduped phone (kind ANNOUNCEMENT, payload {announcementId}).
// Append-only (trigger announcements_append_only): never edited after sending.
model Announcement {
  id                     String   @id @default(uuid()) @db.Uuid
  academyId              String   @map("academy_id") @db.Uuid
  createdById            String   @map("created_by_id") @db.Uuid
  title                  String   @db.VarChar(200)
  body                   String   @db.VarChar(2000)
  sentAt                 DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)
  expiresAt              DateTime @map("expires_at") @db.Timestamptz(6)
  whatsappRecipientCount Int      @map("whatsapp_recipient_count")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  academy                Academy  @relation("AnnouncementAcademy", fields: [academyId], references: [id], onDelete: Restrict)
  createdBy              User     @relation("AnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([academyId, sentAt(sort: Desc)], map: "announcements_academy_sent_idx")
  @@index([academyId, expiresAt], map: "announcements_academy_expires_idx")
  @@map("announcements")
}

enum ComplaintCategory {
  TEACHING_QUALITY
  BEHAVIOUR
  PUNCTUALITY
  TECHNICAL
  BILLING
  OTHER
}

enum ComplaintStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum ComplaintPartyRole {
  TEACHER
  STUDENT
  GUARDIAN
}

// Phase 7 (owner, 2026-10-26): complaint about a party of ONE session. Visible ONLY
// to Admin/Supervisor (lib/complaints/service.ts); the concerned party never sees it
// and is never notified automatically.
model Complaint {
  id              String              @id @default(uuid()) @db.Uuid
  academyId       String              @map("academy_id") @db.Uuid
  sessionId       String              @map("session_id") @db.Uuid
  filedById       String              @map("filed_by_id") @db.Uuid
  filedByRole     ComplaintPartyRole  @map("filed_by_role")
  // Both null = "another participant in this session" (unnamed by the filer; DB
  // CHECK complaints_concerned_pair_check keeps them null/set together).
  concernedUserId String?             @map("concerned_user_id") @db.Uuid
  concernedRole   ComplaintPartyRole? @map("concerned_role")
  category        ComplaintCategory
  title           String              @db.VarChar(200)
  body            String              @db.VarChar(4000)
  status          ComplaintStatus     @default(NEW)
  handledById     String?             @map("handled_by_id") @db.Uuid
  resolutionNote  String?             @map("resolution_note") @db.VarChar(4000)
  resolvedAt      DateTime?           @map("resolved_at") @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  academy         Academy             @relation("ComplaintAcademy", fields: [academyId], references: [id], onDelete: Restrict)
  session         Session             @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  filedBy         User                @relation("ComplaintFiledBy", fields: [filedById], references: [id], onDelete: Restrict)
  concernedUser   User?               @relation("ComplaintConcerned", fields: [concernedUserId], references: [id], onDelete: Restrict)
  handledBy       User?               @relation("ComplaintHandledBy", fields: [handledById], references: [id], onDelete: Restrict)

  @@index([academyId, status, createdAt(sort: Desc)], map: "complaints_academy_status_created_idx")
  @@index([sessionId], map: "complaints_session_idx")
  @@index([concernedUserId], map: "complaints_concerned_user_idx")
  @@map("complaints")
}

// D2 / D36 (owner, 2026-10-27; SQL S-1 approved): a manual ATTENDED / STUDENT_ABSENT
// resolution by the Admin (or the Supervisor within 7 days of the scheduled end).
// Append-only audit (prevent_ledger_mutation trigger); one per roster entry. It
// writes the student's attendance + deduction only — never a payroll entry, and it
// does not count as a report. STUDENT_ABSENT never carries a ledger row (CHECK).
model AttendanceResolution {
  id                   String              @id @default(uuid()) @db.Uuid
  academyId            String              @map("academy_id") @db.Uuid
  sessionId            String              @map("session_id") @db.Uuid
  studentId            String              @map("student_id") @db.Uuid
  outcome              String              @db.VarChar(20)
  reason               String
  resolvedById         String              @map("resolved_by") @db.Uuid
  resolvedByRole       String              @map("resolved_by_role") @db.VarChar(16)
  subscriptionLedgerId String?             @map("subscription_ledger_id") @db.Uuid
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  academy              Academy             @relation("AttendanceResolutionAcademy", fields: [academyId], references: [id], onDelete: Restrict)
  session              Session             @relation("AttendanceResolutionSession", fields: [sessionId], references: [id], onDelete: Restrict)
  student              Student             @relation("AttendanceResolutionStudent", fields: [studentId], references: [id], onDelete: Restrict)
  resolvedBy           User                @relation("AttendanceResolutionResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
  subscriptionLedger   SubscriptionLedger? @relation("AttendanceResolutionLedger", fields: [subscriptionLedgerId], references: [id], onDelete: Restrict, map: "attendance_resolutions_ledger_fkey")

  @@unique([sessionId, studentId], map: "attendance_resolutions_session_student_key")
  @@index([academyId, createdAt(sort: Desc)], map: "attendance_resolutions_academy_created_idx")
  @@map("attendance_resolutions")
}

/// S-4 (D12): per-user read state of inbox team-queue items; ids-only keys.
model NotificationRead {
  userId  String   @map("user_id") @db.Uuid
  itemKey String   @map("item_key") @db.VarChar(200)
  readAt  DateTime @default(now()) @map("read_at") @db.Timestamptz(6)
  user    User     @relation("NotificationReadUser", fields: [userId], references: [id], onDelete: Restrict)

  @@id([userId, itemKey])
  @@map("notification_reads")
}
