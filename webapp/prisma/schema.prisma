generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
  GUARDIAN
}

enum ApplicationType {
  GUARDIAN
  STUDENT
  TEACHER
}

enum ApplicationStatus {
  NEW
  REVIEWED
  APPROVED
  REJECTED
}

model Academy {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @unique
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  users        User[]
  applications Application[]
  subjects     Subject[]

  @@map("academies")
}

model User {
  id                 String      @id @default(uuid()) @db.Uuid
  academyId          String      @map("academy_id") @db.Uuid
  username           String
  email              String?
  passwordHash       String      @map("password_hash")
  displayName        String      @map("display_name")
  phone              String?
  role               UserRole
  timezone           String      @default("Africa/Cairo")
  isActive           Boolean     @default(true) @map("is_active")
  mustChangePassword Boolean     @default(true) @map("must_change_password")
  passwordChangedAt  DateTime?   @map("password_changed_at") @db.Timestamptz(6)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  academy            Academy     @relation(fields: [academyId], references: [id], onDelete: Restrict)
  reviewedApplications Application[] @relation("ApplicationReviewer")
  approvedApplications Application[] @relation("ApplicationApprover")

  @@index([academyId])
  @@unique([academyId, username])
  @@map("users")
}

model Subject {
  id          String   @id @default(uuid()) @db.Uuid
  academyId   String   @map("academy_id") @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  academy     Academy  @relation(fields: [academyId], references: [id], onDelete: Restrict)

  @@unique([academyId, name])
  @@map("subjects")
}

model Application {
  id             String            @id @default(uuid()) @db.Uuid
  academyId      String            @map("academy_id") @db.Uuid
  applicationType ApplicationType  @map("application_type")
  details        Json
  contactPhone   String            @map("contact_phone")
  contactEmail   String?           @map("contact_email")
  status         ApplicationStatus @default(NEW)
  reviewedById   String?           @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  approvedUserId String?           @map("approved_user_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  academy        Academy           @relation(fields: [academyId], references: [id], onDelete: Restrict)
  reviewedBy     User?             @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  approvedUser   User?             @relation("ApplicationApprover", fields: [approvedUserId], references: [id], onDelete: Restrict)

  @@index([academyId, status, createdAt])
  @@index([contactPhone, applicationType, createdAt])
  @@map("applications")
}
