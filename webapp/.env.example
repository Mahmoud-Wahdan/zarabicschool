DATABASE_URL=
DIRECT_URL=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
DEMO_PASSWORD=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Paymob (EGP) — the names the provider implementation actually reads
# (lib/payments/paymob.ts). Names only; never commit real values.
PAYMOB_API_URL=https://accept.paymob.com
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID_EGP=
PAYMOB_IFRAME_ID_EGP=
PAYMOB_HMAC_SECRET=
# USD gateway — placeholders until the owner resolves Dodo vs Xpay (OPEN — do not configure)
USD_GATEWAY_API_KEY=
USD_GATEWAY_WEBHOOK_SECRET=
# WhatsApp via OpenWA (lib/messaging/openwa-provider.ts). OPENWA_URL = the
# OpenWA base URL WITHOUT the /api suffix (the adapter adds /api/...).
OPENWA_URL=
OPENWA_API_KEY=
OPENWA_SESSION_ID=
# Secret shared with the OpenWA webhook registration; POST /api/whatsapp/status
# verifies X-OpenWA-Signature with it (unset = every delivery webhook is 401).
OPENWA_WEBHOOK_SECRET=
# Non-production safety net: comma-separated numbers the app may message.
# Outside NODE_ENV=production nothing else is ever sent (demo seed numbers).
OPENWA_SEND_ALLOWLIST=
# Production same-origin allowlist for mutating API routes (lib/request.ts).
ALLOWED_ORIGINS=
# File storage — Cloudinary (private "authenticated" assets, signed server-side
# uploads, short-lived signed downloads; lib/storage/cloudinary-storage.ts).
# Names only; the API secret is server-only and never sent to the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# LEGACY Supabase Storage — read-only, for attachment rows written before the
# Cloudinary switch (storage_provider = 'supabase'). Remove once the owner decides
# what happens to those objects.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=report-attachments
