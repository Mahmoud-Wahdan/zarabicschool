# Production same-origin allowlist for EVERY state-changing API route
# (POST/PATCH/PUT/DELETE — lib/request.ts requireSameOrigin / isSameOrigin).
# - Read ONLY when NODE_ENV=production. In development the browser Origin is
#   compared with the Host header instead, so this can stay empty locally.
# - Format: one origin, or several separated by commas (spaces are trimmed).
#   An origin = scheme + host (+ port if not default): https://example.com
#   Exact string match against the browser's Origin header, so:
#     * include the scheme (https://), no path, NO trailing slash;
#     * www and non-www are DIFFERENT origins: list both if both are served,
#       e.g. https://example.com,https://www.example.com
#     * a non-default port must be written: https://example.com:8443
# - Set it in the HOSTING PROVIDER's environment variables (not only in a local
#   file), then restart/redeploy the app — it is read at request time from the
#   process environment.
# - Failure looks like: pages load and logins work, but every save/submit/approve
#   answers 403 {"error":{"code":"ORIGIN_NOT_ALLOWED"}}. Empty or wrong value =
#   fail closed. Fix: compare the browser's Origin (DevTools → Network → request
#   headers) with this list character by character, correct it, redeploy.
ALLOWED_ORIGINS=
# File storage — Cloudinary (private "authenticated" assets, signed server-side
# uploads, short-lived signed downloads; lib/storage/cloudinary-storage.ts).
# Names only; the API secret is server-only and never sent to the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# A6: automatic monthly renewal for payers (S-RENEW). OFF unless exactly "true";
# keep it off until one Paymob test-mode sign-up, renewal and refund are verified.
FEATURE_AUTO_RENEWAL=
