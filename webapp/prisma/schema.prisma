  recipientUser   User     @relation("AdminMessageRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  createdBy       User     @relation("AdminMessageCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([academyId, createdAt(sort: Desc)], map: "admin_messages_academy_created_idx")
  @@index([recipientUserId], map: "admin_messages_recipient_idx")
  @@map("admin_messages")
}

